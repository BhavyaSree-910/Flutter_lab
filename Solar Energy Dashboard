// ANALYTICS PAGE

class AnalyticsPage extends StatefulWidget {
  const AnalyticsPage({super.key});
  @override
  State<AnalyticsPage> createState() => _AnalyticsPageState();
}

class _AnalyticsPageState extends State<AnalyticsPage> {
  String period = 'Weekly';
  final data = {
    'Daily': [[3, 5, 4, 7, 6, 8, 5], [2, 4, 3, 5, 4, 6, 3]],
    'Weekly': [[5, 7, 6, 9, 8, 10, 7], [3, 5, 4, 6, 5, 7, 4]],
    'Monthly': [[6, 8, 7, 10, 9, 12, 11], [4, 6, 5, 7, 6, 8, 5]],
  };

  @override
  Widget build(BuildContext context) {
    final g = data[period]![0], c = data[period]![1];
    final totalG = g.reduce((a, b) => a + b);
    final totalC = c.reduce((a, b) => a + b);

    return ListView(padding: const EdgeInsets.all(16), children: [
      const Heading('Energy Analytics'),
      const Text('Monitor generation and consumption trends.'),
      const SizedBox(height: 18),
      SegmentedButton<String>(
        segments: const [
          ButtonSegment(value: 'Daily', label: Text('Daily')),
          ButtonSegment(value: 'Weekly', label: Text('Weekly')),
          ButtonSegment(value: 'Monthly', label: Text('Monthly')),
        ],
        selected: {period},
        onSelectionChanged: (v) => setState(() => period = v.first),
      ),
      const SizedBox(height: 20),
      Card(child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          const Text('Generation vs Consumption',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
          const SizedBox(height: 12),
          const Wrap(spacing: 15, children: [
            Legend(Colors.green, 'Generated'),
            Legend(Colors.orange, 'Consumed'),
          ]),
          const SizedBox(height: 25),
          SizedBox(height: 190, child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceAround,
            crossAxisAlignment: CrossAxisAlignment.end,
            children: List.generate(7, (i) => Column(
              mainAxisAlignment: MainAxisAlignment.end,
              children: [
                Row(crossAxisAlignment: CrossAxisAlignment.end, children: [
                  Bar(g[i], Colors.green), const SizedBox(width: 3),
                  Bar(c[i], Colors.orange),
                ]),
                const SizedBox(height: 8),
                Text('D${i + 1}', style: const TextStyle(fontSize: 11)),
              ],
            )),
          )),
          const Text('Sample energy values in kWh'),
        ]),
      )),
      const SizedBox(height: 16),
      Row(children: [
        Expanded(child: Metric('Generated', '$totalG kWh', Icons.solar_power, Colors.green)),
        const SizedBox(width: 10),
        Expanded(child: Metric('Consumed', '$totalC kWh', Icons.bolt, Colors.orange)),
      ]),
      const SizedBox(height: 16),
      InfoTile(Icons.trending_up, 'Peak Generation', '${g.reduce(max)} kWh is the highest sample value.'),
      InfoTile(Icons.compare_arrows, 'Energy Comparison',
          'Generation exceeds consumption by ${totalG - totalC} kWh.'),
    ]);
  }
}

// SMART ALERTS

class AlertsPage extends StatelessWidget {
  final double battery, generated, consumed;
  const AlertsPage({super.key, required this.battery,
    required this.generated, required this.consumed});

  @override
  Widget build(BuildContext context) {
    final alerts = <Widget>[];

    if (battery <= 20) {
      alerts.add(const AlertTile(Icons.battery_alert, 'Low Battery Warning',
          'Battery level is below 20%.', Colors.red));
    }
    if (battery >= 80) {
      alerts.add(const AlertTile(Icons.battery_full, 'Battery Almost Full',
          'Battery level is above 80%.', Colors.green));
    }
    if (consumed > generated * 0.8) {
      alerts.add(const AlertTile(Icons.warning, 'High Consumption',
          'Consumption is close to generation.', Colors.orange));
    }
    if (generated >= 25) {
      alerts.add(const AlertTile(Icons.emoji_events, 'Generation Goal Reached',
          'Your sample daily generation goal is achieved.', Colors.green));
    }
    if (alerts.isEmpty) {
      alerts.add(const AlertTile(Icons.check_circle, 'System Normal',
          'No critical alerts in the current demo.', Colors.green));
    }

    return ListView(padding: const EdgeInsets.all(16), children: [
      const Heading('Smart Alerts'),
      const Text('Notifications based on energy conditions.'),
      const SizedBox(height: 18),
      ...alerts,
      const Text('Alerts are generated using sample values.',
          style: TextStyle(fontSize: 12)),
    ]);
  }
}

