import 'dart:math';
import 'package:flutter/material.dart';

void main() => runApp(const SolarApp());

const darkGreen = Color(0xFF14532D);
const lightGreen = Color(0xFFF1F8F3);

class SolarApp extends StatefulWidget {
  const SolarApp({super.key});
  @override
  State<SolarApp> createState() => _SolarAppState();
}

class _SolarAppState extends State<SolarApp> {
  bool dark = false;

  @override
  Widget build(BuildContext context) => MaterialApp(
    debugShowCheckedModeBanner: false,
    themeMode: dark ? ThemeMode.dark : ThemeMode.light,
    theme: ThemeData(
      colorScheme: ColorScheme.fromSeed(seedColor: darkGreen),
      scaffoldBackgroundColor: lightGreen,
      appBarTheme: const AppBarTheme(
        backgroundColor: darkGreen,
        foregroundColor: Colors.white,
      ),
      useMaterial3: true,
    ),
    darkTheme: ThemeData(
      colorScheme: ColorScheme.fromSeed(
        seedColor: darkGreen,
        brightness: Brightness.dark,
      ),
      useMaterial3: true,
    ),
    home: Dashboard(
      dark: dark,
      onTheme: (v) => setState(() => dark = v),
    ),
  );
}

class Dashboard extends StatefulWidget {
  final bool dark;
  final ValueChanged<bool> onTheme;
  const Dashboard({super.key, required this.dark, required this.onTheme});

  @override
  State<Dashboard> createState() => _DashboardState();
}

class _DashboardState extends State<Dashboard> {
  int page = 0;
  double generated = 24.5, consumed = 15.2, battery = 78, exported = 4.3;

  double get savings => consumed * 8;
  double get co2 => generated * 0.82;
  double get trees => co2 / 21;
  double get backup => battery * 0.06;

  void refresh() {
    setState(() {
      generated = 26.8;
      consumed = 17.1;
      exported = 3.7;
      battery = 85;
    });
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Demo data refreshed!')),
    );
  }

  @override
  Widget build(BuildContext context) {
    final pages = [
      HomePage(
        generated: generated, consumed: consumed, battery: battery,
        exported: exported, savings: savings, co2: co2,
        trees: trees, backup: backup, onRefresh: refresh,
      ),
      const AnalyticsPage(),
      AlertsPage(battery: battery, generated: generated, consumed: consumed),
      SettingsPage(
        dark: widget.dark,
        onTheme: widget.onTheme,
        battery: battery,
        onBattery: (v) => setState(() => battery = v),
      ),
    ];

    return Scaffold(
      appBar: AppBar(
        title: const Row(children: [
          Icon(Icons.solar_power),
          SizedBox(width: 8),
          Text('SolarSense', style: TextStyle(fontWeight: FontWeight.bold)),
        ]),
        actions: [
          IconButton(
            icon: const Icon(Icons.notifications_outlined),
            onPressed: () => setState(() => page = 2),
          ),
        ],
      ),
      body: IndexedStack(index: page, children: pages),
      bottomNavigationBar: NavigationBar(
        selectedIndex: page,
        onDestinationSelected: (v) => setState(() => page = v),
        destinations: const [
          NavigationDestination(icon: Icon(Icons.home_outlined), label: 'Home'),
          NavigationDestination(icon: Icon(Icons.analytics_outlined), label: 'Analytics'),
          NavigationDestination(icon: Icon(Icons.notifications_outlined), label: 'Alerts'),
          NavigationDestination(icon: Icon(Icons.settings_outlined), label: 'Settings'),
        ],
      ),
    );
  }
}

